IOBUF PORT "amiga_r[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_g[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_b[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_r[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_g[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_b[6]" IO_TYPE=LVCMOS33;
