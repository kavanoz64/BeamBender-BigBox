IOBUF PORT "adc_fsel" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_hsync_n" IO_TYPE=LVCMOS33;
IOBUF PORT "amiga_csync_n" IO_TYPE=LVCMOS33;
