IOBUF PORT "amiga_psel" IO_TYPE=LVCMOS33;
IOBUF PORT "adc_reset_n" IO_TYPE=LVCMOS33;
IOBUF PORT "hdmi_int_n" IO_TYPE=LVCMOS33;
