IOBUF PORT "i2c_scl" IO_TYPE=LVCMOS33;
IOBUF PORT "i2c_sda" IO_TYPE=LVCMOS33;
IOBUF PORT "clk_14m" IO_TYPE=LVCMOS33;
IOBUF PORT "clk_24m576" IO_TYPE=LVCMOS33;
