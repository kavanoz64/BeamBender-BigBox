IOBUF PORT "hdmi_cec" IO_TYPE=LVCMOS33;
IOBUF PORT "btn_3" IO_TYPE=LVCMOS33;
IOBUF PORT "adc_mclk" IO_TYPE=LVCMOS33;

# Series damping is fitted on the board for the clock nets, so no
# extra drive strength is requested here.

# ------------------------------------------------------------ frequencies
FREQUENCY PORT "clk_c28o"   28.636 MHz;   # NTSC worst case (PAL 28.375)
FREQUENCY PORT "clk_14m"    14.318 MHz;   # NTSC worst case (PAL 14.187)
FREQUENCY PORT "clk_27m"    27.000 MHz;
FREQUENCY PORT "clk_24m576" 24.576 MHz;

# Derived, for reference once the PLLs are instantiated:
#   clk_27m  x5.5 -> 148.500 MHz  pixel clock, 1080p50 and 1080p60
#   clk_14m  x2   ->  28.375 MHz  A2000/A3000 capture clock
